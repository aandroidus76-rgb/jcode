pkgname=jcode
_repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
pkgver="$(sed -n 's/^version = "\([^"]*\)".*/\1/p' "$_repo_root/Cargo.toml" | head -n1)"
pkgrel=1
pkgdesc="AI coding agent with a terminal UI"
arch=('x86_64')
url="https://github.com/1jehuang/jcode"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cmake' 'pkgconf' 'rust')
source=()
sha256sums=()

build() {
    cd "$_repo_root"
    cargo build --locked --release -p jcode --bin jcode
}

package() {
    install -Dm755 "$_repo_root/target/release/jcode" "$pkgdir/usr/bin/jcode"
    install -Dm644 "$_repo_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
